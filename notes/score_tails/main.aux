\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Fixed-score check of \Cref  {thm:exposure,thm:energycost}, with no training. Scalar futures $v\sim t_3$; the truth is a Gaussian tilt of the marginal centred at $1$; $T=\{v>22.2\}$ with $\pi =10^{-4}$. The plateau scores are exact in the bulk and have $\rho =A$ on $T$. OF is the over-forecast factor $\mathbb  {E}\,\nu ^{N}(T)/\pi $, ``bound'' the lower bound \eqref  {eq:growth} divided by $\pi $ (the upper bound is $P_N/\pi \le N$), and $\mathcal  {E}_N$ the expected excess energy score, all estimated from simulated banks. OF follows $\min (N,A)$, and $\mathcal  {E}_N$ peaks at $N\approx A$ for the plateau scores and grows without bound for the unbounded score.}}{19}{table.5}\protected@file@percent }
\newlabel{tab:plateau}{{5}{19}{Fixed-score check of \Cref {thm:exposure,thm:energycost}, with no training. Scalar futures $v\sim t_3$; the truth is a Gaussian tilt of the marginal centred at $1$; $T=\{v>22.2\}$ with $\pi =10^{-4}$. The plateau scores are exact in the bulk and have $\rho =A$ on $T$. OF is the over-forecast factor $\E \,\nu ^{N}(T)/\pi $, ``bound'' the lower bound \eqref {eq:growth} divided by $\pi $ (the upper bound is $P_N/\pi \le N$), and $\mathcal {E}_N$ the expected excess energy score, all estimated from simulated banks. OF follows $\min (N,A)$, and $\mathcal {E}_N$ peaks at $N\approx A$ for the plateau scores and grows without bound for the unbounded score}{table.5}{}}
